name: Replenish Japanese exam library

on:
  schedule:
    # Daily 07:47 JST (22:47 UTC), 90 minutes after the English reading job.
    - cron: '47 22 * * *'
  workflow_dispatch:
  push:
    branches: [main]
    paths:
      - '.github/workflows/replenish-japanese.yml'

permissions:
  contents: write
  actions: write

concurrency:
  group: japanese-exam-replenishment
  cancel-in-progress: false

jobs:
  replenish:
    runs-on: ubuntu-latest
    timeout-minutes: 75
    env:
      GEMINI_API_KEY: ${{ secrets.GEMINI_API_KEY }}
      GEMINI_MODEL: ${{ vars.GEMINI_MODEL || 'gemini-3.5-flash' }}
      GEMINI_FREE_TIER_CONFIRMED: 'true'
      GROQ_API_KEY: ${{ secrets.GROQ_API_KEY }}
      GROQ_MODEL: openai/gpt-oss-20b
    steps:
      - uses: actions/checkout@v4
        with:
          ref: main
          fetch-depth: 0

      - uses: actions/setup-node@v4
        with:
          node-version: '22'

      - name: Require backend secrets
        shell: bash
        run: |
          set -euo pipefail
          test -n "${GEMINI_API_KEY:-}"
          test -n "${GROQ_API_KEY:-}"
          case "${GEMINI_MODEL}" in
            gemini-3.5-flash|gemini-3.6-flash|gemini-3.7-flash) ;;
            *) echo "Unapproved Gemini model: ${GEMINI_MODEL}" >&2; exit 1 ;;
          esac
          test "${GROQ_MODEL}" = 'openai/gpt-oss-20b'

      - name: Validate current Japanese library
        run: node scripts/japanese-library.mjs

      - name: Run deterministic Japanese tests
        run: |
          node tests/japanese-exam.mjs
          node tests/japanese-groq-verifier.mjs

      - name: Generate one candidate and independently verify
        run: node scripts/japanese-library.mjs --generate | tee /tmp/japanese-generation.json

      - name: Record generation outcome
        shell: bash
        run: |
          set -euo pipefail
          node - <<'NODE'
          const fs = require('fs');
          const result = JSON.parse(fs.readFileSync('/tmp/japanese-generation.json', 'utf8'));
          const status = JSON.parse(fs.readFileSync('japanese-exam/generation-status.json', 'utf8'));
          console.log(JSON.stringify({ result, persistedStatus: status }));
          NODE

      - name: Revalidate accepted library
        if: always()
        run: node scripts/japanese-library.mjs

      - name: Save accepted content and generation status
        if: always()
        env:
          GH_TOKEN: ${{ github.token }}
        shell: bash
        run: |
          set -euo pipefail
          node scripts/japanese-library.mjs
          git config user.name 'github-actions[bot]'
          git config user.email '41898282+github-actions[bot]@users.noreply.github.com'
          git add japanese-exam/catalog.json japanese-exam/generation-status.json
          if [ -d japanese-exam/items ]; then git add japanese-exam/items; fi
          if ! git diff --cached --quiet; then
            git commit -m 'Add verified Japanese exam pack and generation status'
            for n in 1 2 3; do
              git pull --rebase origin main
              if git push origin HEAD:main; then break; fi
              if [ "$n" = 3 ]; then exit 1; fi
            done
          fi

      - name: Publish accepted pack to GitHub Pages and wait for public verification
        if: always()
        env:
          GH_TOKEN: ${{ github.token }}
        shell: bash
        run: |
          set -euo pipefail
          ADDED=$(node -p "JSON.parse(require('fs').readFileSync('japanese-exam/generation-status.json','utf8')).added || 0")
          if [ "$ADDED" != "1" ]; then
            echo 'No verified pack was accepted; Pages deployment is not needed.'
            exit 0
          fi

          git fetch origin main
          SOURCE_SHA=$(git rev-parse origin/main)
          gh workflow run deploy-pages.yml --ref main

          RUN_ID=''
          for n in $(seq 1 24); do
            RUN_ID=$(gh run list --workflow deploy-pages.yml --branch main --event workflow_dispatch --limit 20 \
              --json databaseId,headSha,status,createdAt \
              --jq ".[] | select(.headSha == \"${SOURCE_SHA}\") | .databaseId" | head -1)
            if [ -n "$RUN_ID" ]; then break; fi
            sleep 5
          done
          test -n "$RUN_ID"
          echo "Waiting for Pages/public verification run ${RUN_ID} at ${SOURCE_SHA}"
          gh run watch "$RUN_ID" --exit-status

      - name: Require an accepted pack or an already-used daily slot
        if: always()
        shell: bash
        run: |
          set -euo pipefail
          node - <<'NODE'
          const fs = require('fs');
          const resultPath = '/tmp/japanese-generation.json';
          const outcome = fs.existsSync(resultPath)
            ? JSON.parse(fs.readFileSync(resultPath, 'utf8'))
            : JSON.parse(fs.readFileSync('japanese-exam/generation-status.json', 'utf8'));
          if (outcome.added === 1 || outcome.state === 'daily_limit') {
            console.log(`Japanese replenishment outcome: ${outcome.state}`);
            process.exit(0);
          }
          console.error(`Japanese replenishment did not add a pack: ${outcome.state || 'unknown'} / ${outcome.reason || 'no reason'}`);
          process.exit(1);
          NODE

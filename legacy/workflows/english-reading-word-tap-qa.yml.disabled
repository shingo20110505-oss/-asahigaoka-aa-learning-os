name: English reading word tap QA

on:
  push:
    branches: [main]
    paths:
      - 'app/learning/english-reading-word-tap-v1.js'
      - 'app/runtime-registry.js'
      - 'english-reading/index.html'
      - '.github/workflows/english-reading-word-tap-qa.yml'
  workflow_dispatch:

permissions:
  contents: read

jobs:
  production-word-tap:
    runs-on: ubuntu-latest
    timeout-minutes: 12
    steps:
      - name: Checkout exact source
        uses: actions/checkout@v4
        with:
          ref: ${{ github.sha }}
          fetch-depth: 1

      - name: Syntax and loader contract
        run: |
          node --check app/learning/english-reading-word-tap-v1.js
          grep -q "english-reading-word-tap-v1.js?v=1.0.0" app/runtime-registry.js
          grep -q "riseWordTapVerify" app/learning/english-reading-word-tap-v1.js

      - name: Wait for exact Pages release
        env:
          BASE: https://shingo20110505-oss.github.io/-asahigaoka-aa-learning-os/
        run: |
          set -euo pipefail
          ok=0
          for n in $(seq 1 72); do
            if curl -fsSL --connect-timeout 10 --max-time 25 "${BASE}release.json?wordtap=${GITHUB_SHA}-${n}" -o /tmp/release.json && grep -q "${GITHUB_SHA}" /tmp/release.json; then
              ok=1
              break
            fi
            sleep 5
          done
          test "$ok" = 1

      - name: Tap a word in the production browser
        env:
          BASE: https://shingo20110505-oss.github.io/-asahigaoka-aa-learning-os/
        run: |
          set -euo pipefail
          CHROME=$(command -v google-chrome || command -v google-chrome-stable || command -v chromium || command -v chromium-browser || true)
          test -n "$CHROME"
          PROFILE="/tmp/rise-english-reading-wordtap-${GITHUB_SHA}"
          rm -rf "$PROFILE"
          timeout 150s "$CHROME" \
            --headless=new \
            --no-sandbox \
            --disable-gpu \
            --disable-dev-shm-usage \
            --window-size=390,844 \
            --user-data-dir="$PROFILE" \
            --virtual-time-budget=90000 \
            --dump-dom "${BASE}english-reading/?tap_verify=1&verify=${GITHUB_SHA}" > /tmp/english-reading-wordtap.html
          grep -q 'data-rise-word-tap-ready="1"' /tmp/english-reading-wordtap.html
          grep -q 'data-rise-word-tap-verify="pass"' /tmp/english-reading-wordtap.html
          grep -q 'id="riseWordTapSheet"' /tmp/english-reading-wordtap.html
          grep -q '知らなかった・復習する' /tmp/english-reading-wordtap.html
          echo 'ENGLISH_READING_WORD_TAP_PUBLIC=PASS'

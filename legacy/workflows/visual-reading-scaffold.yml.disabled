name: Rise support reading production visual verification

on:
  workflow_run:
    workflows: ["Deploy AA Learning OS to GitHub Pages"]
    types: [completed]
  workflow_dispatch:

permissions:
  contents: read
  actions: read

concurrency:
  group: rise-support-reading-production-visual
  cancel-in-progress: true

jobs:
  visual:
    # The main deploy can finish as failure after Pages was successfully deployed
    # when an unrelated global quality-runtime check fails. In that case this
    # feature-specific QA must still inspect the exact published release.
    if: github.event_name == 'workflow_dispatch' || github.event.workflow_run.conclusion != 'cancelled'
    runs-on: ubuntu-latest
    timeout-minutes: 10
    steps:
      - name: Resolve published source
        id: source
        env:
          WORKFLOW_SHA: ${{ github.event.workflow_run.head_sha }}
        run: |
          set -euo pipefail
          SOURCE_SHA="${WORKFLOW_SHA:-$GITHUB_SHA}"
          echo "source_sha=${SOURCE_SHA}" >> "$GITHUB_OUTPUT"
          echo "SOURCE_SHA=${SOURCE_SHA}" >> "$GITHUB_ENV"
          echo "PAGE_URL=https://shingo20110505-oss.github.io/-asahigaoka-aa-learning-os/" >> "$GITHUB_ENV"

      - name: Checkout exact published source
        uses: actions/checkout@v4
        with:
          ref: ${{ steps.source.outputs.source_sha }}
          fetch-depth: 1

      - name: Wait for exact production release and reading runtime
        run: |
          set -euo pipefail
          ok=0
          for n in $(seq 1 24); do
            if curl -fsSL --connect-timeout 10 --max-time 25 "${PAGE_URL}release.json?reading_visual=${SOURCE_SHA}-${n}" -o /tmp/release.json && grep -q "${SOURCE_SHA}" /tmp/release.json; then
              ok=1
              break
            fi
            sleep 5
          done
          test "$ok" = 1
          curl -fsSL --connect-timeout 10 --max-time 30 "${PAGE_URL}ai-reading-exam-scaffold-v1.js?reading_visual=${SOURCE_SHA}" -o /tmp/reading-scaffold.js
          cmp -s ai-reading-exam-scaffold-v1.js /tmp/reading-scaffold.js
          grep -q "VERSION='1.1.0'" /tmp/reading-scaffold.js
          grep -q "ENTRANCE_DIFFICULTY=9" /tmp/reading-scaffold.js
          grep -q "入試問題と同じ形式" /tmp/reading-scaffold.js
          grep -q "installStudyHook" /tmp/reading-scaffold.js
          grep -q "legacySupport" /tmp/reading-scaffold.js
          node --check scripts/rise-reading-scaffold-visual-v1.mjs

      - name: Install Japanese rendering fonts
        run: |
          set -euo pipefail
          sudo apt-get update -qq
          sudo apt-get install -y --no-install-recommends fonts-noto-cjk
          fc-cache -f

      - name: Capture support reading production UI
        env:
          VISUAL_OUT: reading-scaffold-evidence
        run: |
          set -euo pipefail
          CHROME_PATH=$(command -v google-chrome || command -v google-chrome-stable || command -v chromium || command -v chromium-browser || true)
          test -n "$CHROME_PATH"
          export CHROME_PATH
          rm -rf reading-scaffold-evidence
          node scripts/rise-reading-scaffold-visual-v1.mjs
          grep -q '^result=success$' reading-scaffold-evidence/manifest.txt
          grep -q '^production_entry=verified$' reading-scaffold-evidence/manifest.txt
          grep -q '^support_action=ai-reading-scaffold$' reading-scaffold-evidence/manifest.txt
          grep -q '^support_click_route=verified$' reading-scaffold-evidence/manifest.txt
          grep -q '^persistent_hooks=verified$' reading-scaffold-evidence/manifest.txt
          grep -q '^support_format=aichi-exam$' reading-scaffold-evidence/manifest.txt
          grep -q '^preteach=removed$' reading-scaffold-evidence/manifest.txt
          grep -q '^chatgpt_during_attempt=removed$' reading-scaffold-evidence/manifest.txt
          test "$(find reading-scaffold-evidence -maxdepth 1 -name '*.png' | wc -l)" -eq 4
          cat reading-scaffold-evidence/manifest.txt

      - name: Upload support reading screenshot evidence
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: rise-support-reading-production-${{ steps.source.outputs.source_sha }}
          path: reading-scaffold-evidence/
          if-no-files-found: warn
          retention-days: 30

      - name: Visual verification summary
        if: success()
        run: |
          {
            echo '## Rise support reading production visual evidence'
            echo ''
            echo "- Source: \`${SOURCE_SHA}\`"
            echo '- Production Study screen is connected to the verified AI reading runtime.'
            echo '- The support button routes to `ai-reading-scaffold` and the actual click reaches the AI reading route.'
            echo '- The final studyHTML/subjectsHTML hooks remain installed after later learning-engine layers load.'
            echo '- Support reading uses the Aichi entrance-exam reading presentation.'
            echo '- Five-question / four-choice exam flow is retained.'
            echo '- Upfront vocabulary preteach is removed.'
            echo '- ChatGPT help is removed during the attempt.'
            echo '- Only in-text vocabulary support distinguishes scaffold mode.'
            echo '- Mobile: `390x844`'
            echo '- Desktop: `1440x1000`'
          } >> "$GITHUB_STEP_SUMMARY"

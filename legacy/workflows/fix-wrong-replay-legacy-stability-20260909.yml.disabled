name: Restore unified quiz stable review controller 20260909
on:
  push:
    paths:
      - '.fix-wrong-replay-legacy-stability-20260909-trigger'
permissions:
  contents: write
jobs:
  patch:
    runs-on: ubuntu-latest
    timeout-minutes: 10
    steps:
      - uses: actions/checkout@v4
        with:
          fetch-depth: 0
      - name: Restore review controller from last known-good revision
        shell: bash
        run: |
          set -euo pipefail
          git fetch origin main
          git reset --hard origin/main
          git checkout 3c00df93a97657f21648056ab225d2ca063992ca -- quiz/review-algorithm-v1.js
          python - <<'PY'
          from pathlib import Path
          import re
          p=Path('quiz/index.html')
          s=p.read_text(encoding='utf-8')
          s=re.sub(r'(review-algorithm-v1\.js\?v=)[^\"\']+',r'\g<1>1.0.9-stable-20260909',s)
          p.write_text(s,encoding='utf-8')
          js=Path('quiz/review-algorithm-v1.js').read_text(encoding='utf-8')
          assert "function activeSubject()" in js
          assert "ui.start?.addEventListener('click'" in js
          assert 'review-algorithm-v1.js?v=1.0.9-stable-20260909' in s
          print('stable unified review controller restored')
          PY
          node --check quiz/review-algorithm-v1.js
          git config user.name github-actions[bot]
          git config user.email 41898282+github-actions[bot]@users.noreply.github.com
          git add quiz/review-algorithm-v1.js quiz/index.html
          if git diff --cached --quiet; then exit 0; fi
          git commit -m 'Restore stable unified quiz review controller'
          git push origin HEAD:main

name: Rise vocabulary foundation audit

on:
  pull_request:
    paths:
      - 'vocabulary-core/**'
      - 'quiz/**'
      - 'scripts/audit-vocabulary-foundation.mjs'
      - 'scripts/audit-vocabulary-normalization.mjs'
      - 'scripts/audit-vocabulary-progress-adapters.mjs'
      - 'scripts/audit-unified-vocabulary-quiz.mjs'
      - 'scripts/test-unified-quiz-controller.mjs'
      - 'scripts/audit-kokugo-taxonomy-v1.mjs'
      - 'scripts/report-vocabulary-data-quality.mjs'
      - 'vocab.html'
      - 'vocab-wrong-quiz-v1.js'
      - 'ai-reading-v1.js'
      - 'app/legacy/main-runtime.js'
      - 'app/ui/rise-learning-expansion-v1.js'
      - 'learning-engine-v15.js'
      - 'kokugo-chronologia/**'
      - 'chronologia.html'
      - 'chronologia-v7-data-*.js'
      - 'chronologia-force1000-v1.js'
      - '.github/workflows/vocabulary-foundation-audit.yml'
  push:
    branches: [main]
    paths:
      - 'vocabulary-core/**'
      - 'quiz/**'
      - 'scripts/audit-vocabulary-foundation.mjs'
      - 'scripts/audit-vocabulary-normalization.mjs'
      - 'scripts/audit-vocabulary-progress-adapters.mjs'
      - 'scripts/audit-unified-vocabulary-quiz.mjs'
      - 'scripts/test-unified-quiz-controller.mjs'
      - 'scripts/audit-kokugo-taxonomy-v1.mjs'
      - 'scripts/report-vocabulary-data-quality.mjs'
      - 'vocab.html'
      - 'vocab-wrong-quiz-v1.js'
      - 'ai-reading-v1.js'
      - 'app/legacy/main-runtime.js'
      - 'app/ui/rise-learning-expansion-v1.js'
      - 'learning-engine-v15.js'
      - 'kokugo-chronologia/**'
      - 'chronologia.html'
      - 'chronologia-v7-data-*.js'
      - 'chronologia-force1000-v1.js'
      - '.github/workflows/vocabulary-foundation-audit.yml'
  workflow_dispatch:

permissions:
  contents: read

jobs:
  audit:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: '24'
      - name: Audit vocabulary foundation contracts
        run: node scripts/audit-vocabulary-foundation.mjs
      - name: Report vocabulary data quality
        run: node scripts/report-vocabulary-data-quality.mjs
      - name: Audit Japanese taxonomy integrity
        run: node scripts/audit-kokugo-taxonomy-v1.mjs
      - name: Upload Japanese taxonomy audit
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: kokugo-taxonomy-audit
          path: artifacts/kokugo-taxonomy-audit.json
          if-no-files-found: warn
          retention-days: 14
      - name: Audit native normalization readiness
        run: node scripts/audit-vocabulary-normalization.mjs
      - name: Audit read-only progress adapters
        run: node scripts/audit-vocabulary-progress-adapters.mjs
      - name: Audit unified native vocabulary quiz
        run: node scripts/audit-unified-vocabulary-quiz.mjs
      - name: Test unified quiz controller behavior
        run: node scripts/test-unified-quiz-controller.mjs

name: Verified Gemini Reading Audit
on:
  push:
    branches: [main]
    paths:
      - 'ai-reading-v1.js'
      - 'ai-reading-library-v1.js'
      - 'ai-reading-library/**'
      - 'scripts/reading-library.mjs'
      - 'worker/src/index.mjs'
      - 'tests/reading-library.mjs'
      - 'vocab.html'
      - 'index.html'
      - '.github/workflows/reading-1000-audit.yml'
  workflow_dispatch:
permissions:
  contents: read
jobs:
  audit:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: '22'
      - name: Check verified content, provenance, selection and vocabulary linkage
        run: |
          node tests/ai-reading-contract.mjs
          node tests/reading-library.mjs
          node scripts/reading-library.mjs --validate

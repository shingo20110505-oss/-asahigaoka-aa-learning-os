name: Diagnose Rise Quality Runtime

on:
  workflow_run:
    workflows: ['Deploy AA Learning OS to GitHub Pages']
    types: [completed]
  workflow_dispatch:

permissions:
  contents: read

env:
  PAGE_URL: https://shingo20110505-oss.github.io/-asahigaoka-aa-learning-os/

jobs:
  diagnose:
    runs-on: ubuntu-latest
    env:
      SOURCE_SHA: ${{ github.event.workflow_run.head_sha || github.sha }}
    steps:
      - name: Checkout exact source commit
        uses: actions/checkout@v4
        with:
          ref: ${{ env.SOURCE_SHA }}
          fetch-depth: 1

      - name: Wait for exact Pages release
        run: |
          set -euo pipefail
          BASE="${PAGE_URL%/}/"
          ok=0
          for n in $(seq 1 30); do
            if curl -fsSL --connect-timeout 10 --max-time 25 "${BASE}release.json?qualitydiag=${SOURCE_SHA}-${n}" -o /tmp/release.json; then
              if node -e "const x=require('/tmp/release.json'); process.exit(x.sourceSha===process.env.SOURCE_SHA?0:1)"; then
                ok=1
                break
              fi
            fi
            sleep 5
          done
          test "$ok" = 1

      - name: Run production quality audit and capture diagnostics
        id: quality
        continue-on-error: true
        run: |
          set +e
          CHROME=$(command -v google-chrome || command -v google-chrome-stable || command -v chromium || command -v chromium-browser || true)
          export CHROME_PATH="$CHROME"
          PAGE_URL="${PAGE_URL%/}/" SOURCE_SHA="$SOURCE_SHA" node scripts/rise-quality-cdp.mjs > quality-runtime-diagnostic.log 2>&1
          code=$?
          echo "exit_code=$code" >> "$GITHUB_OUTPUT"
          {
            echo "source_sha=$SOURCE_SHA"
            echo "exit_code=$code"
            echo "chrome=$CHROME"
            echo "checked_at=$(date -u +'%Y-%m-%dT%H:%M:%SZ')"
          } > quality-runtime-status.txt
          cat quality-runtime-diagnostic.log
          exit "$code"

      - name: Extract quality result
        if: always()
        run: |
          set +e
          grep '^AA_QUALITY_CI=' quality-runtime-diagnostic.log > quality-runtime-result.txt
          grep '^RISE_QUALITY_DIAGNOSTICS=' quality-runtime-diagnostic.log >> quality-runtime-result.txt
          grep '^RISE_QUALITY_TIMEOUT=' quality-runtime-diagnostic.log >> quality-runtime-result.txt
          grep '^RISE_DOCUMENTS=' quality-runtime-diagnostic.log >> quality-runtime-result.txt
          tail -n 120 quality-runtime-diagnostic.log > quality-runtime-tail.txt

      - name: Upload diagnostics
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: rise-quality-runtime-${{ env.SOURCE_SHA }}
          path: |
            quality-runtime-status.txt
            quality-runtime-result.txt
            quality-runtime-tail.txt
            quality-runtime-diagnostic.log
          retention-days: 3

      - name: Fail if production audit failed
        if: always()
        run: test "${{ steps.quality.outputs.exit_code }}" = "0"

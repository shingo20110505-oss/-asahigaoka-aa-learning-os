{
  "name": "rise-pc-chat",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-22",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {"directory": "../dist", "binding": "ASSETS", "run_worker_first": ["/api/*", "/_rise/*"]},
  "durable_objects": {"bindings": [{"name": "RISE_RELAY", "class_name": "RiseRelay"}]},
  "migrations": [{"tag": "v1", "new_sqlite_classes": ["RiseRelay"]}],
  "observability": {"enabled": false}
}
